    <sect1>
        <title>Configuration Syntax Quick Reference</title>
        
        <sect2>
            <title>Postfix main.cf Syntax</title>
            <programlisting># Comments start with #
parameter = value

# Multi-line values use indentation
parameter = value1,
    value2,
    value3

# Whitespace around = is optional but recommended
parameter = value

# Access variables
parameter = $other_parameter

# Common variable syntax
myhostname = mail.example.com
mydomain = example.com
myorigin = $mydomain
mydestination = $myhostname, localhost.$mydomain, localhost, $mydomain</programlisting>
        </sect2>
        
        <sect2>
            <title>Postfix master.cf Syntax</title>
            <programlisting># service type  private unpriv  chroot  wakeup  maxproc command
smtp      inet  n       -       n       -       -       smtpd

# Indented lines are command options
submission inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes</programlisting>
        </sect2>
        
        <sect2>
            <title>Dovecot Configuration Syntax</title>
            <programlisting># Comments start with #
setting = value

# Sections use curly braces
protocol imap {
  mail_plugins = $mail_plugins imap_quota
}

# Subsections
service auth {
  unix_listener auth-userdb {
    mode = 0600
    user = postfix
  }
}</programlisting>
        </sect2>
        
        <sect2>
            <title>Apache Configuration Syntax</title>
            <programlisting># Comments start with #
# Directives
ServerName mail.example.com

# Sections use angle brackets
&lt;VirtualHost *:443>
    ServerName mail.example.com
    DocumentRoot /srv/www/htdocs
    
    # Nested sections
    &lt;Directory /srv/www/htdocs/roundcube>
        AllowOverride All
        Require all granted
    &lt;/Directory>
&lt;/VirtualHost></programlisting>
        </sect2>
    </sect1>
    
    <sect1>
        <title>Common Testing Commands</title>
        <table>
            <title>Testing and Diagnostics</title>
            <tgroup cols="2">
                <thead>
                    <row>
                        <entry>Test</entry>
                        <entry>Command</entry>
                    </row>
                </thead>
                <tbody>
                    <row>
                        <entry>Test SMTP connection</entry>
                        <entry><command>telnet localhost 25</command></entry>
                    </row>
                    <row>
                        <entry>Test SMTP with TLS</entry>
                        <entry><command>openssl s_client -connect localhost:587 -starttls
                            smtp</command></entry>
                    </row>
                    <row>
                        <entry>Test IMAPS connection</entry>
                        <entry><command>openssl s_client -connect localhost:993</command></entry>
                    </row>
                    <row>
                        <entry>Check if port is listening</entry>
                        <entry><command>sudo netstat -tlnp | grep :&lt;port></command></entry>
                    </row>
                    <row>
                        <entry>Alternative port check</entry>
                        <entry><command>sudo ss -tlnp | grep :&lt;port></command></entry>
                    </row>
                    <row>
                        <entry>Test DNS MX lookup</entry>
                        <entry><command>dig MX example.com</command></entry>
                    </row>
                    <row>
                        <entry>Simple DNS lookup</entry>
                        <entry><command>host example.com</command></entry>
                    </row>
                    <row>
                        <entry>Check certificate expiration</entry>
                        <entry><command>openssl x509 -in &lt;file> -noout -dates</command></entry>
                    </row>
                    <row>
                        <entry>Check certificate details</entry>
                        <entry><command>openssl x509 -in &lt;file> -noout -text</command></entry>
                    </row>
                    <row>
                        <entry>Verify cert/key match</entry>
                        <entry><command>openssl x509 -noout -modulus -in &lt;cert> | openssl
                            md5</command></entry>
                    </row>
                    <row>
                        <entry>Test mail delivery</entry>
                        <entry><command>echo "Test" | mail -s "Subject" user@domain.com</command></entry>
                    </row>
                    <row>
                        <entry>Check firewall rules</entry>
                        <entry><command>sudo iptables -L -n -v</command></entry>
                    </row>
                    <row>
                        <entry>Scan open ports</entry>
                        <entry><command>nmap -p 25,587,993,443 localhost</command></entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
    </sect1>
    
    <sect1>
        <title>Log Monitoring Commands</title>
        <para>Commands for viewing and monitoring log files:</para>
        <screen># View last 50 lines of mail log
$> sudo tail -50 /var/log/mail.info

# Follow mail log in real-time
$> sudo tail -f /var/log/mail.info

# View mail errors only
$> sudo grep -i error /var/log/mail.err

# Search for specific email address
$> sudo grep "user@example.com" /var/log/mail.info

# View today's authentication failures
$> sudo grep "$(date '+%b %e')" /var/log/mail.warn | grep -i "auth.*failed"

# Count authentication failures
$> sudo grep "authentication failed" /var/log/mail.warn | wc -l

# View Apache errors from last hour
$> sudo tail -100 /var/log/apache2/error_log

# Search Apache log for specific IP
$> sudo grep "192.168.1.100" /var/log/apache2/access_log

# View systemd journal for service
$> sudo journalctl -u postfix -n 50
$> sudo journalctl -u dovecot -n 50

# Follow journal in real-time
$> sudo journalctl -u postfix -f</screen>
    </sect1>
    
    <sect1>
        <title>Useful One-Liners</title>
        <para>Handy commands for common tasks:</para>
        <screen># List all local users with mail
$> ls -1 /home/*/Maildir/new | wc -l

# Check disk space usage by mailboxes
$> du -sh /home/*/Maildir | sort -h

# Find large messages in queue
$> find /var/spool/postfix -type f -size +1M -ls

# Count messages in queue by status
$> sudo qshape active
$> sudo qshape deferred

# Show current IMAP connections
$> sudo netstat -tn | grep :993 | wc -l

# Show top 10 sender addresses in queue
$> mailq | grep '^[A-F0-9]' | awk '{print $7}' | sort | uniq -c | sort -rn | head -10

# Check if TLS is working
$> echo QUIT | openssl s_client -connect localhost:993 2>/dev/null | grep "Verify return code"

# Test authentication
$> printf "\\0username\\0password" | base64
# Use output in: AUTH PLAIN &lt;base64-string>

# Reload all mail services
$> for svc in postfix dovecot apache2; do sudo systemctl reload $svc; done

# Check all service status
$> for svc in postfix dovecot apache2 mysql; do systemctl is-active $svc; done</screen>
    </sect1>
    
    <sect1>
        <title>Emergency Procedures</title>
        
        <sect2>
            <title>Stop All Mail Processing</title>
            <screen>$> sudo systemctl stop postfix
$> sudo systemctl stop dovecot</screen>
        </sect2>
        
        <sect2>
            <title>Clear All Queued Mail (Use with Caution!)</title>
            <screen>$> sudo postsuper -d ALL
$> sudo postqueue -p  # Verify queue is empty</screen>
        </sect2>
        
        <sect2>
            <title>Revert to Backup Configuration</title>
            <screen># Assuming you have backups in /root/backup
$> sudo cp /root/backup/main.cf /etc/postfix/main.cf
$> sudo cp /root/backup/dovecot.conf /etc/dovecot/dovecot.conf
$> sudo postfix check
$> sudo systemctl restart postfix
$> sudo systemctl restart dovecot</screen>
        </sect2>
        
        <sect2>
            <title>Disable Service at Boot (If Problematic)</title>
            <screen>$> sudo systemctl disable postfix
$> sudo systemctl disable dovecot</screen>
        </sect2>
    </sect1>
