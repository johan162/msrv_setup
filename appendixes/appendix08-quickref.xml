    <title>Quick Reference Guide</title>
    <para>This appendix provides quick reference information for common tasks, commands, file
        locations, and configuration syntax.</para>
    
    <sect1>
        <title>Service Management Commands</title>
        
        <sect2>
            <title>Controlling Services</title>
            <table>
                <title>Service Control Commands</title>
                <tgroup cols="2">
                    <thead>
                        <row>
                            <entry>Task</entry>
                            <entry>Command</entry>
                        </row>
                    </thead>
                    <tbody>
                        <row>
                            <entry>Start service</entry>
                            <entry><command>sudo systemctl start &lt;service></command></entry>
                        </row>
                        <row>
                            <entry>Stop service</entry>
                            <entry><command>sudo systemctl stop &lt;service></command></entry>
                        </row>
                        <row>
                            <entry>Restart service</entry>
                            <entry><command>sudo systemctl restart &lt;service></command></entry>
                        </row>
                        <row>
                            <entry>Reload configuration</entry>
                            <entry><command>sudo systemctl reload &lt;service></command></entry>
                        </row>
                        <row>
                            <entry>Check status</entry>
                            <entry><command>sudo systemctl status &lt;service></command></entry>
                        </row>
                        <row>
                            <entry>Enable at boot</entry>
                            <entry><command>sudo systemctl enable &lt;service></command></entry>
                        </row>
                        <row>
                            <entry>Disable at boot</entry>
                            <entry><command>sudo systemctl disable &lt;service></command></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
            <para>Service names: <literal>postfix</literal>, <literal>dovecot</literal>,
                    <literal>apache2</literal>, <literal>mysql</literal></para>
        </sect2>
        
        <sect2>
            <title>Postfix-Specific Commands</title>
            <table>
                <title>Postfix Commands</title>
                <tgroup cols="2">
                    <thead>
                        <row>
                            <entry>Task</entry>
                            <entry>Command</entry>
                        </row>
                    </thead>
                    <tbody>
                        <row>
                            <entry>Check configuration syntax</entry>
                            <entry><command>sudo postfix check</command></entry>
                        </row>
                        <row>
                            <entry>Reload configuration</entry>
                            <entry><command>sudo postfix reload</command></entry>
                        </row>
                        <row>
                            <entry>View mail queue</entry>
                            <entry><command>mailq</command> or <command>postqueue -p</command></entry>
                        </row>
                        <row>
                            <entry>Flush mail queue</entry>
                            <entry><command>sudo postqueue -f</command></entry>
                        </row>
                        <row>
                            <entry>Delete message from queue</entry>
                            <entry><command>sudo postsuper -d &lt;queue-id></command></entry>
                        </row>
                        <row>
                            <entry>Delete all queued mail</entry>
                            <entry><command>sudo postsuper -d ALL</command></entry>
                        </row>
                        <row>
                            <entry>View configuration parameter</entry>
                            <entry><command>postconf &lt;parameter></command></entry>
                        </row>
                        <row>
                            <entry>View all configuration</entry>
                            <entry><command>postconf</command></entry>
                        </row>
                        <row>
                            <entry>View message content</entry>
                            <entry><command>postcat -q &lt;queue-id></command></entry>
                        </row>
                        <row>
                            <entry>Test SMTP connection</entry>
                            <entry><command>telnet localhost 25</command></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </sect2>
        
        <sect2>
            <title>Dovecot-Specific Commands</title>
            <table>
                <title>Dovecot Commands</title>
                <tgroup cols="2">
                    <thead>
                        <row>
                            <entry>Task</entry>
                            <entry>Command</entry>
                        </row>
                    </thead>
                    <tbody>
                        <row>
                            <entry>View configuration</entry>
                            <entry><command>doveconf</command></entry>
                        </row>
                        <row>
                            <entry>View specific setting</entry>
                            <entry><command>doveconf &lt;setting></command></entry>
                        </row>
                        <row>
                            <entry>Test authentication</entry>
                            <entry><command>doveadm auth test &lt;user> &lt;password></command></entry>
                        </row>
                        <row>
                            <entry>Force mailbox re-indexing</entry>
                            <entry><command>doveadm force-resync -u &lt;user> '*'</command></entry>
                        </row>
                        <row>
                            <entry>List user mailboxes</entry>
                            <entry><command>doveadm mailbox list -u &lt;user></command></entry>
                        </row>
                        <row>
                            <entry>Show who is logged in</entry>
                            <entry><command>doveadm who</command></entry>
                        </row>
                        <row>
                            <entry>Test IMAP connection</entry>
                            <entry><command>openssl s_client -connect localhost:993</command></entry>
                        </row>
                        <row>
                            <entry>Test SMTP submission with TLS</entry>
                            <entry><command>openssl s_client -connect localhost:587 -starttls smtp</command></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </sect2>
    </sect1>
    
